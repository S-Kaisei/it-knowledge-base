{
  "name": "it-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ITの仕組みを、基礎から実践まで。",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "npm run content:generate -- --drafts --lenient && INCLUDE_DRAFTS=true react-router dev",
    "content:generate": "node scripts/generate-content.mjs",
    "content:check": "node scripts/validate-content.mjs",
    "typecheck": "npm run content:generate && react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "build": "npm run content:generate && react-router build && node scripts/postbuild.mjs && pagefind --site ${BUILD_DIR:-build}/client",
    "build:subpath": "BASE_PATH=/it-knowledge-base/ BUILD_DIR=build-subpath npm run build",
    "build:e2e": "CONTENT_DIR=tests/fixtures/content/valid BUILD_DIR=build-e2e npm run build && CONTENT_DIR=tests/fixtures/content/valid BASE_PATH=/it-knowledge-base/ BUILD_DIR=build-e2e-subpath npm run build",
    "build:drafts": "INCLUDE_DRAFTS=true ALLOW_DRAFT_BUILD=true BUILD_DIR=build-drafts npm run build",
    "links:check": "node scripts/check-links.mjs",
    "links:check:subpath": "BASE_PATH=/it-knowledge-base/ BUILD_DIR=build-subpath node scripts/check-links.mjs",
    "serve": "node scripts/serve-static.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:drafts": "npm run build:drafts && node scripts/screenshots.mjs --dir build-drafts/client",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.1",
    "@mdx-js/react": "3.1.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@react-router/node": "8.5.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "isbot": "5.2.4",
    "katex": "0.19.1",
    "lucide-react": "1.82.0",
    "mermaid": "12.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "8.5.3",
    "@shikijs/rehype": "4.6.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "gray-matter": "4.0.3",
    "hast-util-to-string": "3.0.1",
    "jsdom": "31.0.1",
    "markdownlint-cli2": "0.24.2",
    "pagefind": "1.6.0",
    "prettier": "3.10.1",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "unist-util-visit": "5.2.0",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "zod": "4.6.7"
  }
}
